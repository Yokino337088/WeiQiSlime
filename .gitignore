# ======================================
# Unity 引擎缓存目录（绝对禁止上传）
# ======================================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Dd]ebug/
[Bb]uild/
[Bb]uilds/
[Pp]ackage[Cc]ache/
Logs/
UserSettings/
MemoryCaptures/
AssetStoreCache/
PackageManagerCache/

# ======================================
# 打包输出、平台编译产物
# ======================================
*.apk
*.exe
*.app
*.ipa
*.dll
*.pdb
*.mdb
*.log
output_log.txt

# ======================================
# VS / Rider 编辑器文件
# ======================================
.vs/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.cache
.idea/
*.DotSettings

# ======================================
# macOS / Windows 系统垃圾文件
# ======================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ======================================
# 自定义临时文件、测试文件
# ======================================
*.bak
*.tmp
~$*